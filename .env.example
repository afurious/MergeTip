# Copy to .env (`cp .env.example .env`). Read by the backend (api, worker) and docker compose.

# --- database ---
DATABASE_URL=postgres://mergetip:mergetip@localhost:5432/mergetip
# Host port for the compose Postgres; change it (and DATABASE_URL) if 5432 is already taken.
POSTGRES_PORT=5432

# --- runtime ---
# dev | staging | production. Logs are JSON outside dev; production refuses unsafe settings.
APP_ENV=dev
RUST_LOG=info,mergetip=debug

# --- api ---
API_ADDR=0.0.0.0:8080
# The web app's origin (no path): the only CORS origin, and the base for links in bot replies.
PUBLIC_BASE_URL=http://localhost:5173
# This API's public origin (no path). GitHub sends sign-ins back to $API_PUBLIC_URL/v1/auth/github/callback,
# which must be listed in the GitHub App's callback URLs. The worker needs it too, for unsubscribe links.
API_PUBLIC_URL=http://localhost:8080
# Comma-separated browser-extension origins allowed to make cookie-authenticated writes.
EXTENSION_ORIGINS=

# --- worker ---
# Jobs run concurrently per worker process.
WORKER_CONCURRENCY=8
# Staging demos only: mark verified tips paid with a fake proof, and treat every sender as having
# a wallet. Refused when APP_ENV=production.
STUB_PAYER=false

# --- secrets (api and worker) ---
# 32-byte hex master key for envelope encryption. Generate: openssl rand -hex 32
MASTER_KEY=
# Set only while rotating: the old key, so existing ciphertexts stay readable until re-wrapped.
MASTER_KEY_PREVIOUS=

# --- GitHub App (written by `make dev-app`) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./.secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
SMEE_URL=
# Optional: GitHub API base URL (GitHub Enterprise or a local mock). Defaults to api.github.com.
GITHUB_API_URL=
# Optional: GitHub web base URL for OAuth (GitHub Enterprise or a local mock). Defaults to github.com.
GITHUB_OAUTH_URL=

# --- Lightning / NWC ---
# Network invoices must be for: bitcoin (production), signet, testnet or regtest (local mocks).
LIGHTNING_NETWORK=regtest
NOSTR_FALLBACK_RELAY=ws://localhost:7000
MOCK_LNURL_URL=http://localhost:8090
# Shared by mock-nwc and mock-lnurl so the mock wallet can pay the mock invoices (dev only).
MOCK_SEED=6d657267657469702d6c6f63616c2d6d6f636b2d736565642d30303030303030
# Optional fixed 32-byte hex keys for a stable mock wallet URI across restarts.
MOCK_NWC_WALLET_SECRET=
MOCK_NWC_APP_SECRET=

# --- email ---
# Resend is used when its key is set; otherwise plain SMTP (dev only: Mailpit); otherwise no email.
RESEND_API_KEY=
EMAIL_FROM="MergeTip <tips@mail.mergetip.dev>"
SMTP_URL=smtp://localhost:1025
# Svix signing secret (whsec_...) for Resend delivery events at /v1/webhooks/resend. Unset: disabled.
RESEND_WEBHOOK_SECRET=

# --- web app ---
PUBLIC_API_URL=http://localhost:8080
PUBLIC_BREEZ_API_KEY=

# --- observability ---
# Errors go to Sentry when set (api and worker).
SENTRY_DSN=
# Prometheus /metrics on this internal address (never route it publicly). Unset: disabled.
METRICS_ADDR=127.0.0.1:9090
OTEL_EXPORTER_OTLP_ENDPOINT=
