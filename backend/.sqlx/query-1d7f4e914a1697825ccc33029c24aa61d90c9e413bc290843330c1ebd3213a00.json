{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT i.id, i.github_installation_id, i.account_login, i.suspended_at\n        FROM installations i\n        JOIN installation_repos r ON r.installation_id = i.id\n        WHERE lower(r.full_name) = lower($1) AND i.suspended_at IS NULL\n        LIMIT 1\n        ",
