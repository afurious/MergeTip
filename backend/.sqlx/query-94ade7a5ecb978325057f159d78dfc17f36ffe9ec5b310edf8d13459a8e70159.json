  "db_name": "PostgreSQL",
  "query": "\n        SELECT s.id, s.user_id, s.kind, s.expires_at, s.last_seen_at, s.created_at\n        FROM sessions s JOIN users u ON u.id = s.user_id\n        WHERE s.token_hash = $1 AND s.expires_at > $2 AND u.deleted_at IS NULL\n        ",
