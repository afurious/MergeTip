    "/v1/email/unsubscribe": {
      "get": {
        "tags": [
          "email"
        ],
        "summary": "The page behind the link in an email: it asks before unsubscribing. Opening a link must not\nchange anything (RFC 8058): mail scanners and link previews fetch every link in a message.",
        "operationId": "unsubscribe_link",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "description": "The signed token from the email's link.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page with an unsubscribe button (HTML)",
            "content": {
              "text/html": {}
            }
          },
          "400": {
            "description": "`invalid_token`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "email"
        ],
        "summary": "Unsubscribe: RFC 8058 one-click from a mail client (`List-Unsubscribe=One-Click`, answered\n204), or the button on the confirm page (answered with a page).",
        "operationId": "unsubscribe_one_click",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "description": "The signed token from the email's link.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "`List-Unsubscribe=One-Click` from a mail client, or empty from the confirm page",
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Unsubscribed (from the confirm page; HTML)",
            "content": {
              "text/html": {}
            }
          },
          "204": {
            "description": "Unsubscribed (one-click)"
          },
          "400": {
            "description": "`invalid_token`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
