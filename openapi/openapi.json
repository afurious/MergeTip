      "get": {
        "tags": [
          "users"
        ],
        "summary": "Whether a GitHub user can receive a tip right now. Unknown users can't, yet.",
        "operationId": "receive_status",
        "parameters": [
          {
            "name": "login",
            "in": "path",
            "description": "GitHub login",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReceiveStatus"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/v1/webhooks/github": {
      "post": {
        "tags": [
          "webhooks"
        ],
        "summary": "Receive a GitHub App webhook delivery.",
        "operationId": "receive_github_webhook",
        "parameters": [
          {
            "name": "X-Hub-Signature-256",
            "in": "header",
            "description": "`sha256=` HMAC of the raw body",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-GitHub-Event",
            "in": "header",
            "description": "Event name, e.g. `issue_comment`",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-GitHub-Delivery",
            "in": "header",
            "description": "Unique delivery ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Raw event payload",
          "content": {
            "application/json": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Stored for processing (or already stored)"
          },
          "400": {
            "description": "A required header is missing or the body is not JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Signature missing or wrong",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/webhooks/resend": {
      "post": {
        "tags": [
          "webhooks"
        ],
        "summary": "Receive a Resend delivery event (Svix-signed) and update the email status of every tip the\nmessage covered (FR-11.7).",
        "operationId": "receive_resend_webhook",
        "parameters": [
          {
            "name": "svix-id",
            "in": "header",
            "description": "Unique message ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "svix-timestamp",
            "in": "header",
            "description": "Unix seconds when it was sent",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "svix-signature",
            "in": "header",
            "description": "Space-separated `v1,<base64>` signatures",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Raw event payload",
          "content": {
            "application/json": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Recorded, or ignored as irrelevant"
          },
          "401": {
            "description": "Signature missing, wrong or too old",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Resend webhooks aren't configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddressRequest": {
        "type": "object",
        "required": [
          "address"
        ],
        "properties": {
          "address": {
            "type": "string",
            "description": "A Lightning address such as `alice@getalby.com`."
          }
        }
      },
      "Caps": {
        "type": "object",
        "required": [
          "per_tip_max_sats",
          "daily_max_sats",
          "spent_today_sats"
        ],
        "properties": {
          "daily_max_sats": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "per_tip_max_sats": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "spent_today_sats": {
            "type": "integer",
            "format": "int64",
            "description": "Sats paid or in flight since midnight UTC.",
            "minimum": 0
          }
        }
      },
      "ClaimRequest": {
        "type": "object",
        "properties": {
          "lightning_address": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where to receive the sats. Omit to use the address already saved in settings."
          }
        },
        "additionalProperties": false
      },
      "ConfirmRequest": {
        "type": "object",
        "properties": {
          "otp": {
            "type": [
              "string",
              "null"
            ],
            "description": "The emailed code; required when confirmation codes are on."
          }
        },
        "additionalProperties": false
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable `snake_case` identifier, e.g. `nwc_invalid_uri`."
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ExtensionToken": {
        "type": "object",
        "required": [
          "token",
          "expires_at"
        ],
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "token": {
            "type": "string",
            "description": "Send as `Authorization: Bearer <token>`."
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `ok` when the process can serve requests."
          },
          "version": {
            "type": "string",
            "description": "The running build's version."
          }
        }
      },
      "Me": {
        "type": "object",
        "required": [
          "id",
          "github_login",
          "avatar_url",
          "wallet",
          "caps",
          "confirm_threshold_sats",
          "confirm_otp_enabled",
          "email_opt_out"
        ],
        "properties": {
          "avatar_url": {
            "type": "string"
          },
          "caps": {
            "$ref": "#/components/schemas/Caps"
          },
          "confirm_otp_enabled": {
            "type": "boolean"
          },
          "confirm_threshold_sats": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "email_opt_out": {
            "type": "boolean"
          },
          "github_login": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "lightning_address": {
            "type": [
              "string",
              "null"
            ]
          },
          "wallet": {
            "$ref": "#/components/schemas/WalletStatus"
          }
        }
      },
      "PostedTipComment": {
        "type": "object",
        "required": [
          "comment_url"
        ],
        "properties": {
          "comment_url": {
            "type": "string"
          }
        }
      },
      "ReceiveMethod": {
        "type": "string",
        "enum": [
          "lightning_address",
          "none"
        ]
      },
      "ReceiveStatus": {
        "type": "object",
        "required": [
          "login",
          "method"
        ],
        "properties": {
          "login": {
            "type": "string"
          },
          "method": {
            "$ref": "#/components/schemas/ReceiveMethod"
          }
        }
      },
      "SettingsRequest": {
        "type": "object",
        "properties": {
          "confirm_otp_enabled": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "confirm_threshold_sats": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "daily_max_sats": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "email_opt_out": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "per_tip_max_sats": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "Tip": {
        "type": "object",
        "required": [
          "id",
          "state",
          "amount_sats",
          "kind",
          "sender",
          "receiver",
          "repo",
          "thread_number",
          "thread_url",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "amount_sats": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the tip's current wait ends: the confirmation deadline while it awaits confirmation,\notherwise the sender or pledge deadline."
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "now",
              "on_merge"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "payment_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "receiver": {
            "$ref": "#/components/schemas/UserRef"
          },
          "repo": {
            "type": "string",
            "description": "`owner/name`."
          },
          "sender": {
            "$ref": "#/components/schemas/UserRef"
          },
          "state": {
            "$ref": "#/components/schemas/TipState"
          },
          "thread_number": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "thread_url": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TipCommentRequest": {
        "type": "object",
        "required": [
          "repo",
          "thread_number",
          "receiver",
          "amount_sats",
          "kind"
        ],
        "properties": {
          "amount_sats": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "kind": {
            "type": "string",
            "enum": [
              "now",
              "on_merge"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "receiver": {
            "type": "string",
            "description": "GitHub login, without `@`."
          },
          "repo": {
            "type": "string",
            "description": "`owner/name`."
          },
          "thread_number": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "TipEnvelope": {
        "type": "object",
        "description": "`{ tip }`, the body of the claim and confirmation endpoints.",
        "required": [
          "tip"
        ],
        "properties": {
          "tip": {
            "$ref": "#/components/schemas/Tip"
          }
        }
      },
      "TipKindBody": {
        "type": "string",
        "enum": [
          "now",
          "on_merge"
        ]
      },
      "TipList": {
        "type": "object",
        "description": "A page of the signed-in user's tips.",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tip"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pass back as `cursor` for the next page; `null` on the last page."
          }
        }
      },
      "TipState": {
        "type": "string",
        "description": "A tip's state as clients see it.",
        "enum": [
          "received",
          "awaiting_sender",
          "verifying",
          "awaiting_confirmation",
          "held",
          "paying",
          "paid",
          "pledged",
          "rejected",
          "cancelled",
          "expired",
          "failed"
        ]
      },
      "UserRef": {
        "type": "object",
        "required": [
          "login",
          "avatar_url"
        ],
        "properties": {
          "avatar_url": {
            "type": "string"
          },
          "login": {
            "type": "string"
          }
        }
      },
      "WalletRequest": {
        "type": "object",
        "required": [
          "nwc_uri"
        ],
        "properties": {
          "nwc_uri": {
            "type": "string",
            "description": "`nostr+walletconnect://…`. Treated as a password: never stored in plain text, logged or\nreturned."
          }
        }
      },
      "WalletStatus": {
        "type": "object",
        "required": [
          "connected",
          "methods"
        ],
        "properties": {
          "connected": {
            "type": "boolean"
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "NIP-47 methods the wallet granted, e.g. `pay_invoice`."
          },
          "relay": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mt_session"
      }
    }
  },
