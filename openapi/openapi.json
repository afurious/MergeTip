{
  "openapi": "3.1.0",
  "info": {
    "title": "MergeTip API",
    "description": "Generated from the Rust backend with utoipa (`make openapi`). Do not edit by hand.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Liveness probe for load balancers.",
        "description": "Deliberately touches no dependencies, so a database outage doesn't take every machine out of\nrotation at once.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "The process is up",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/extension-token": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Mint a bearer token for the browser extension.",
        "operationId": "create_extension_token",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionToken"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/v1/auth/github/callback": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "GitHub's redirect back after sign-in: create the session and return to the web app.",
        "operationId": "github_callback",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "error",
            "in": "query",
            "description": "Set by GitHub when the user declined.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Signed in; redirect to the web app with the session cookie set"
          },
          "400": {
            "description": "State mismatch or missing code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/github/login": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Start signing in: redirect to GitHub.",
        "operationId": "github_login",
        "parameters": [
          {
            "name": "redirect",
            "in": "query",
            "description": "Web app path to return to after signing in, e.g. `/claim/abc`. Defaults to `/dashboard`.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to GitHub"
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign out of this browser.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Signed out"
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/v1/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Service status and build version.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The service is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "The signed-in user.",
        "operationId": "get_me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/v1/webhooks/github": {
      "post": {
        "tags": [
          "webhooks"
        ],
        "summary": "Receive a GitHub App webhook delivery.",
        "operationId": "receive_github_webhook",
        "parameters": [
          {
            "name": "X-Hub-Signature-256",
            "in": "header",
            "description": "`sha256=` HMAC of the raw body",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-GitHub-Event",
            "in": "header",
            "description": "Event name, e.g. `issue_comment`",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-GitHub-Delivery",
            "in": "header",
            "description": "Unique delivery ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Raw event payload",
          "content": {
            "application/json": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Stored for processing (or already stored)"
          },
          "400": {
            "description": "A required header is missing or the body is not JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Signature missing or wrong",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Caps": {
        "type": "object",
        "required": [
          "per_tip_max_sats",
          "daily_max_sats",
          "spent_today_sats"
        ],
        "properties": {
          "daily_max_sats": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "per_tip_max_sats": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "spent_today_sats": {
            "type": "integer",
            "format": "int64",
            "description": "Sats paid or in flight since midnight UTC.",
            "minimum": 0
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable `snake_case` identifier, e.g. `nwc_invalid_uri`."
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ExtensionToken": {
        "type": "object",
        "required": [
          "token",
          "expires_at"
        ],
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "token": {
            "type": "string",
            "description": "Send as `Authorization: Bearer <token>`."
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `ok` when the process can serve requests."
          },
          "version": {
            "type": "string",
            "description": "The running build's version."
          }
        }
      },
      "Me": {
        "type": "object",
        "required": [
          "id",
          "github_login",
          "avatar_url",
          "wallet",
          "caps",
          "confirm_threshold_sats",
          "confirm_otp_enabled",
          "email_opt_out"
        ],
        "properties": {
          "avatar_url": {
            "type": "string"
          },
          "caps": {
            "$ref": "#/components/schemas/Caps"
          },
          "confirm_otp_enabled": {
            "type": "boolean"
          },
          "confirm_threshold_sats": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "email_opt_out": {
            "type": "boolean"
          },
          "github_login": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "lightning_address": {
            "type": [
              "string",
              "null"
            ]
          },
          "wallet": {
            "$ref": "#/components/schemas/WalletStatus"
          }
        }
      },
      "WalletStatus": {
        "type": "object",
        "required": [
          "connected",
          "methods"
        ],
        "properties": {
          "connected": {
            "type": "boolean"
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "NIP-47 methods the wallet granted, e.g. `pay_invoice`."
          },
          "relay": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mt_session"
      }
    }
  },
  "tags": [
    {
      "name": "meta",
      "description": "Service health"
    },
    {
      "name": "webhooks",
      "description": "Signed deliveries from external services"
    },
    {
      "name": "auth",
      "description": "Signing in and sessions"
    },
    {
      "name": "me",
      "description": "The signed-in user's account and settings"
    }
  ]
}
