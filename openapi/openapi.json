              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      },
      "delete": {
        "tags": [
          "confirmations"
        ],
        "summary": "Cancel a high-value tip instead of confirming it. Nothing is charged.",
        "operationId": "cancel_confirmation",
        "parameters": [
          {
            "name": "tip_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Cancelled"
          },
          "403": {
            "description": "`not_sender`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`not_awaiting_confirmation`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/v1/confirmations/{tip_id}/otp": {
      "post": {
        "tags": [
          "confirmations"
        ],
        "summary": "Email a 6-digit code for confirming this tip (only when the sender turned codes on).",
        "operationId": "send_confirmation_code",
        "parameters": [
          {
            "name": "tip_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Code sent"
          },
          "403": {
            "description": "`not_sender`",
