  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Liveness probe for load balancers.",
        "description": "Deliberately touches no dependencies, so a database outage doesn't take every machine out of\nrotation at once.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "The process is up",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/extension-token": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Mint a bearer token for the browser extension.",
        "operationId": "create_extension_token",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionToken"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/v1/auth/github/callback": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "GitHub's redirect back after sign-in: create the session and return to the web app.",
        "operationId": "github_callback",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "error",
            "in": "query",
            "description": "Set by GitHub when the user declined.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Signed in; redirect to the web app with the session cookie set"
          },
          "400": {
            "description": "State mismatch or missing code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/github/login": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Start signing in: redirect to GitHub.",
        "operationId": "github_login",
        "parameters": [
          {
            "name": "redirect",
            "in": "query",
            "description": "Web app path to return to after signing in, e.g. `/claim/abc`. Defaults to `/dashboard`.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to GitHub"
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign out of this browser.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Signed out"
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/v1/claims/{token}": {
      "get": {
        "tags": [
          "claims"
        ],
        "summary": "The pledge behind a claim link, for the claim page.",
        "operationId": "get_claim",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "description": "The token from the claim link",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TipEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "`claim_not_found`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "410": {
            "description": "`claim_expired`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "claims"
        ],
        "summary": "Claim a pledge as its receiver: the sender's wallet pays it to the receiver's address.",
        "operationId": "claim_tip",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "description": "The token from the claim link",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Optional; an empty body uses the saved address",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TipEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "`not_receiver`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "`claim_not_found`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`already_claimed`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "410": {
            "description": "`claim_expired`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "`no_address`, `lnurl_invalid` or `lnurl_unreachable`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/v1/confirmations/{tip_id}": {
      "get": {
        "tags": [
          "confirmations"
        ],
        "summary": "A high-value tip waiting for its sender's confirmation.",
        "operationId": "get_confirmation",
        "parameters": [
          {
            "name": "tip_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TipEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "`not_sender`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No such tip",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      },
      "post": {
        "tags": [
          "confirmations"
        ],
        "summary": "Confirm a high-value tip: it is paid now, or when its PR merges for an on-merge tip.",
        "operationId": "confirm_tip",
        "parameters": [
          {
            "name": "tip_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Optional unless codes are on",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TipEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "`not_sender`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`not_awaiting_confirmation`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "410": {
            "description": "`confirmation_expired`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
